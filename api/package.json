{
    "name": "batch-api",
    "type": "module",
    "root": true,
    "version": "2.0.0",
    "main": "dist/index.js",
    "license": "MIT",
    "private": true,
    "engines": {
        "node": ">= 22"
    },
    "scripts": {
        "lint": "eslint index.ts routes/ lib/ test/ && tsc --noEmit",
        "build": "tsc && cp package.json dist/ && cp -r migrations dist/ && (cp -r web/dist dist/web/dist 2>/dev/null || true)",
        "test": "./test/test | tap-merge",
        "start": "node dist/index.js --email",
        "migratedb": "tsx ./node_modules/.bin/drizzle-kit generate",
        "dev": "tsx watch -i ./web index.ts",
        "cov-html": "nyc tape 'test/*.test.ts' && nyc report --reporter=html",
        "cov": "nyc tape 'test/*.test.ts' && nyc report --reporter=text-lcov > coverage.lcov && codecov"
    },
    "dependencies": {
        "@aws-sdk/client-auto-scaling": "^3.987.0",
        "@aws-sdk/client-batch": "^3.987.0",
        "@aws-sdk/client-cloudwatch-logs": "^3.987.0",
        "@aws-sdk/client-ecs": "^3.987.0",
        "@aws-sdk/client-s3": "^3.987.0",
        "@aws-sdk/client-secrets-manager": "^3.987.0",
        "@aws-sdk/client-ses": "^3.987.0",
        "@aws-sdk/lib-storage": "^3.540.0",
        "@aws-sdk/s3-request-presigner": "^3.987.0",
        "@mapbox/sphericalmercator": "^1.1.0",
        "@octokit/auth-app": "^7.1.4",
        "@octokit/rest": "^21.1.0",
        "@octokit/webhooks": "13.7.4",
        "@openaddresses/batch-error": "^2.1.0",
        "@openaddresses/batch-generic": "^25.0.0",
        "@openaddresses/batch-schema": "^10.28.1",
        "@openaddresses/lib": "github:openaddresses/lib#v4.5.0",
        "@sinclair/typebox": "^0.34.0",
        "@turf/turf": "^6.5.0",
        "bcrypt": "^5.0.0",
        "busboy": "^1.6.0",
        "cors": "^2.8.5",
        "csv-stringify": "^6.0.0",
        "d3-queue": "^3.0.7",
        "drizzle-orm": "^0.45.2",
        "express": "^5.0.0",
        "express-minify": "^1.0.0",
        "jsonwebtoken": "^9.0.0",
        "mailgen": "^2.0.32",
        "memjs": "^1.3.0",
        "minimist": "^1.2.2",
        "moment": "^2.27.1",
        "object-hash": "^3.0.0",
        "parallel-transform": "^1.2.0",
        "split": "^1.0.1",
        "tape": "^5.6.1",
        "undici": "^6.28.0"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.19",
        "@types/geojson": "^7946.0.16",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/memjs": "^1.3.3",
        "@types/minimist": "^1.2.5",
        "@types/object-hash": "^3.0.6",
        "aws-sdk-client-mock": "^4.1.0",
        "codecov": "^3.8.2",
        "drizzle-kit": "^0.31.10",
        "drizzle-typebox": "^0.3.3",
        "eslint": "^9.0.0",
        "eslint-plugin-n": "^17.10.2",
        "nodemon": "^3.0.0",
        "nyc": "^17.0.0",
        "path-to-regexp": "^6.2.1",
        "tap-merge": "^0.3.1",
        "typescript-eslint": "^8.70.1"
    },
    "allowScripts": {
        "bcrypt@5.1.1": true,
        "sqlite3@5.1.7": true
    }
}
